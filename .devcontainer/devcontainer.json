{
    "name": "Anqi",
    "dockerComposeFile": [
        "./docker-compose.yml"
    ],
    "service": "app",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "JetBrains.kotlin-server"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "JetBrains.kotlin-server",
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                }
            }
        }
    }
}